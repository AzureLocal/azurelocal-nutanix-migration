{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM template for Nutanix to Azure Local migration infrastructure. Organization: Infinite Improbability Corp (IIC).",
    "_generator": {
      "name": "arm"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "iic",
      "metadata": {
        "description": "Short environment identifier used in resource names."
      }
    },
    "suffix": {
      "type": "string",
      "defaultValue": "01",
      "metadata": {
        "description": "Numeric suffix for resource group name."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "kv-iic-migration",
      "metadata": {
        "description": "Name of the Key Vault for migration secrets."
      }
    },
    "migrateProjectName": {
      "type": "string",
      "defaultValue": "migrate-iic-nutanix-01",
      "metadata": {
        "description": "Azure Migrate project name."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "environment": "iic",
        "project": "nutanix-migration",
        "managedBy": "arm"
      },
      "metadata": {
        "description": "Tags applied to all resources."
      }
    }
  },
  "variables": {
    "resourceGroupName": "[concat('rg-', parameters('environment'), '-migration-', parameters('suffix'))]",
    "tenantId": "[subscription().tenantId]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2023-07-01",
      "name": "[variables('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2023-07-01",
      "name": "deploy-keyvault",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "keyVaultName":  { "value": "[parameters('keyVaultName')]" },
          "location":      { "value": "[parameters('location')]" },
          "tenantId":      { "value": "[variables('tenantId')]" },
          "tags":          { "value": "[parameters('tags')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "keyVaultName": { "type": "string" },
            "location":     { "type": "string" },
            "tenantId":     { "type": "string" },
            "tags":         { "type": "object" }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[parameters('keyVaultName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "tenantId": "[parameters('tenantId')]",
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7,
                "networkAcls": {
                  "bypass": "AzureServices",
                  "defaultAction": "Allow"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2023-07-01",
      "name": "deploy-migrate-project",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "projectName": { "value": "[parameters('migrateProjectName')]" },
          "location":    { "value": "[parameters('location')]" },
          "tags":        { "value": "[parameters('tags')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "projectName": { "type": "string" },
            "location":    { "type": "string" },
            "tags":        { "type": "object" }
          },
          "resources": [
            {
              "type": "Microsoft.Migrate/migrateProjects",
              "apiVersion": "2020-05-01",
              "name": "[parameters('projectName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {}
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[variables('resourceGroupName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[parameters('keyVaultName')]"
    },
    "migrateProjectName": {
      "type": "string",
      "value": "[parameters('migrateProjectName')]"
    }
  }
}
