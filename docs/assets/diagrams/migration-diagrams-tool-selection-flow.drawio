        <mxCell id="d3" value="Prefer simplest AHV-native deployment with backup/restore model?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="730" y="640" width="340" height="140" as="geometry"/>
