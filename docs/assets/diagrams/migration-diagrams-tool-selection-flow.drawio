          <mxGeometry x="560" y="20" width="680" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;Need to migrate Nutanix workloads to Azure Local" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4a86e8;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="730" y="90" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="Need hypervisor-independent migration (mixed/legacy or API constraints)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="730" y="230" width="340" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;Choose Carbonite Migrate&lt;/b&gt;&lt;br&gt;Agent-based replication&lt;br&gt;Best for mixed hypervisors and deploy-first patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1230" y="250" width="360" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="d2" value="Need lowest downtime + built-in re-IP + granular control?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="730" y="430" width="340" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="v1" value="&lt;b&gt;Choose Veeam B&amp;R&lt;/b&gt;&lt;br&gt;Live replication, strong control plane,&lt;br&gt;best for larger or complex waves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#4a86e8;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1230" y="450" width="360" height="110" as="geometry"/>
