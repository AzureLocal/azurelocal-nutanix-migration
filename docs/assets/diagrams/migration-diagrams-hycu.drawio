        <mxCell id="b3-azmig" value="Az Migrate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="700" y="610" width="100" height="25" as="geometry"/>
