        </mxCell>
        <mxCell id="arr1-label" value="&lt;b&gt;Backup via AHV API&lt;/b&gt;&lt;br&gt;Native snapshots" style="edgeLabel;html=1;fontSize=9;fontColor=#2e7d32;align=center;" vertex="1" connectable="0" parent="arr1">
