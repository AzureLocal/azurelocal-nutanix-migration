        </mxCell>
        <mxCell id="b3-label" value="Batch 3" style="text;html=1;fontSize=10;fontFamily=Arial;align=right;" vertex="1" parent="1">
          <mxGeometry x="30" y="610" width="80" height="25" as="geometry"/>
